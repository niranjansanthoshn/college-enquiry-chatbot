# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/college_enquiry_db
# For MongoDB Atlas in Production:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/college_enquiry_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
FRONTEND_URL=http://localhost:5173

# AI Model Configuration
# Options: "gemini" (recommended), "openai", or "demo" (grounded database RAG fallback)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Admin Security Key (used for seeding or initial setup)
ADMIN_SETUP_KEY=ApexCollegeAdmin2026SecureKey
